<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure, dependency-free hydraulics/hydrology engine.

    Targets netstandard2.0 deliberately: this is the lowest common denominator
    that loads into every Civil 3D runtime we care about â€”
      Civil 3D 2023 and older  (.NET Framework 4.8)
      Civil 3D 2024            (.NET 7)
      Civil 3D 2025 / 2026     (.NET 8)
    so the same compiled engine ships against any host version without a rebuild.
    No Autodesk references live here on purpose â€” it builds and unit-tests on a
    machine with no CAD installed.
  -->
  <PropertyGroup>
    <!-- net8.0 asset is what the Civil 3D 2025/2026 build loads: it uses the in-box
         System.Text.Json, so it never asks the .NET 8 host for a newer copy.
         netstandard2.0 asset serves the net48 (Civil 3D 2024) build and the tests. -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public types are self-describing; don't fail/clutter on missing XML on every member. -->
    <NoWarn>CS1591</NoWarn>
    <AssemblyName>HydroComplete.Engine</AssemblyName>
    <RootNamespace>HydroComplete.Engine</RootNamespace>
    <Version>1.9.0</Version>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="_wip/**" />
  </ItemGroup>

</Project>
